{
  "name": "workplace-document-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for workplace document scanning and management",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed-users.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --all --include='src/**/*.js' --reporter=text --reporter=lcov npm test"
  },
  "dependencies": {
    "arabic-persian-reshaper": "^1.0.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bidi-js": "^1.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "net-snmp": "^3.26.3",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.1",
    "socket.io": "^4.8.3",
    "text-encoding": "^0.7.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "src/assets/**/*",
      "node_modules/pdfkit/js/data/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  }
}
