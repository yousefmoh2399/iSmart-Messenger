PORT=5000
INSTANCE_ID=backend-01
# For High Availability, use a MongoDB Replica Set URI:
# MONGODB_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/workplace_documents?replicaSet=ismartRS
MONGODB_URI=mongodb://127.0.0.1:27017/workplace_documents
MONGO_WRITE_CONCERN=majority
MONGO_READ_PREFERENCE=primaryPreferred
JWT_SECRET=replace_with_a_long_random_secret_shared_across_all_nodes
BASE_URL=https://ismart.company.local

# Shared/Redundant File Storage (must point to shared NFS/SMB mount on all Backend nodes)
STORAGE_TYPE=shared-fs
UPLOADS_DIR=/data/ismart/uploads
UPLOAD_DIR=/data/ismart/uploads
BACKUPS_DIR=/data/ismart/backups
UPDATE_RELEASES_DIR=/data/ismart/releases
MAX_FILE_SIZE_MB=20
UPDATE_ARTIFACT_MAX_MB=1024

# Comma-separated list of allowed origins. Do NOT use "*" in production.
CORS_ORIGIN=https://ismart.company.local

# Shared Redis for Socket.IO Adapter, Rate Limiting, and Distributed Cron Locks
REDIS_URL=redis://:replace_with_redis_password@127.0.0.1:6379
NODE_ENV=production
TRUST_PROXY=1
ALLOW_DETAILED_HEALTH=false

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_FORCE=false

BOOTSTRAP_ADMIN_USERNAME=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

BOOTSTRAP_ADMIN2_USERNAME=backup-admin@example.com
BOOTSTRAP_ADMIN2_PASSWORD=replace_with_a_strong_password
BOOTSTRAP_ADMIN2_FULL_NAME=Backup Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./ismart-messenger-firebase-adminsdk-fbsvc-4ab072fea4.json